{
  "name": "endocare-gold",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/process-reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
