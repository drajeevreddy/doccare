{
  "name": "endocare-gold",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 0 */3 * *"
    },
    {
      "path": "/api/cron/process-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
